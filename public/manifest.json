{
  "manifest_version": 3,
  "name": "AutoClick Anywhere - DOM & Canvas/WebGL 自动点击器",
  "version": "1.0.0",
  "description": "同时支持普通 DOM 与 Canvas/WebGL 无 DOM 应用的自动点击器：单点、多点序列、滚动、拖拽、宏录制与回放（双引擎 CDP 原生可信输入 + DOM 静默合成）。",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "debugger"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "AutoClick Anywhere",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "commands": {
    "toggle-run": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "启动 / 停止自动执行"
    },
    "toggle-record": {
      "suggested_key": {
        "default": "Alt+Shift+R"
      },
      "description": "开始 / 停止宏录制"
    },
    "toggle-hud": {
      "suggested_key": {
        "default": "Alt+Shift+H"
      },
      "description": "显示 / 隐藏页面悬浮面板"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "playground.html",
        "playground.js",
        "playground.css",
        "content.js",
        "icons/*"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
